#!/usr/bin/env bash
set -Eeuo pipefail

STACK="${1:?Usage: run_baseline.sh quic-go|picoquic|ngtcp2}"

EXP="$HOME/QUICScope/experiments/qlog-interoperability/exp1-support-audit"
BUILDS="$HOME/quic-builds"
FIXTURE="$EXP/fixtures/payload.bin"
CERT="$EXP/runs/picoquic/certs/localhost.crt"
KEY="$EXP/runs/picoquic/certs/localhost.key"

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
RUN="$EXP/runs/validation/$STACK/$RUN_ID"

case "$STACK" in
    quic-go) PORT=4445 ;;
    picoquic) PORT=4446 ;;
    ngtcp2) PORT=4447 ;;
    *) echo "Unknown stack: $STACK" >&2; exit 2 ;;
esac

for f in "$FIXTURE" "$CERT" "$KEY"; do
    test -f "$f" || { echo "Missing file: $f" >&2; exit 1; }
done

mkdir -p "$RUN"/{client_qlog,server_qlog,downloads}

SERVER_PID=""
cleanup() {
    if [[ -n "$SERVER_PID" ]]; then
        kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

export LD_LIBRARY_PATH="$BUILDS/nghttp3-install/lib:${LD_LIBRARY_PATH:-}"

echo "Stack: $STACK"
echo "Run:   $RUN"
echo "Port:  $PORT"

{
    echo "stack=$STACK"
    echo "run_id=$RUN_ID"
    echo "port=$PORT"
    echo "date_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "hostname=$(hostname)"
    echo "payload_bytes=$(wc -c < "$FIXTURE")"
    echo "payload_sha256=$(sha256sum "$FIXTURE" | cut -d' ' -f1)"
    echo "kernel=$(uname -r)"
    echo "ngtcp2_commit=$(git -C "$EXP/ngtcp2" rev-parse HEAD)"
    echo "picoquic_commit=$(git -C "$EXP/picoquic" rev-parse HEAD)"
    echo "quic_go_commit=$(git -C "$HOME/QUICScope/quic-qlog-audit/upstream/quic-go" rev-parse HEAD)"
} > "$RUN/metadata.txt"

tc qdisc show dev lo > "$RUN/loopback_qdisc.txt" 2>&1 || true

case "$STACK" in

    quic-go)
        QLOGDIR="$RUN/server_qlog" \
        "$BUILDS/quic-go/h3server" \
            -bind "127.0.0.1:$PORT" \
            -www "$EXP/fixtures" \
            -cert "$CERT" \
            -key "$KEY" \
            > "$RUN/server.log" 2>&1 &
        SERVER_PID=$!
        ;;

    picoquic)
        "$BUILDS/picoquic/picoquicdemo" \
            -L \
            -p "$PORT" \
            -c "$CERT" \
            -k "$KEY" \
            -w "$EXP/fixtures" \
            -q "$RUN/server_qlog" \
            > "$RUN/server.log" 2>&1 &
        SERVER_PID=$!
        ;;

    ngtcp2)
        "$EXP/ngtcp2/examples/gtlsserver" \
            --htdocs="$EXP/fixtures" \
            --qlog-dir="$RUN/server_qlog" \
            127.0.0.1 "$PORT" "$KEY" "$CERT" \
            > "$RUN/server.log" 2>&1 &
        SERVER_PID=$!
        ;;
esac

sleep 2

if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "Server exited before client started" >&2
    cat "$RUN/server.log"
    exit 1
fi

echo "Starting client..."

set +e
case "$STACK" in

    quic-go)
        QLOGDIR="$RUN/client_qlog" \
        timeout 90 "$BUILDS/quic-go/h3client-verified" \
            -url "https://localhost:$PORT/payload.bin" \
            -out "$RUN/downloads/payload.bin" \
            -ca "$CERT" \
            > "$RUN/client.log" 2>&1
        STATUS=$?
        ;;

    picoquic)
        timeout 90 "$BUILDS/picoquic/picoquicdemo" \
            -L \
            -n localhost \
            -T "$RUN/fresh_tickets.bin" \
            -q "$RUN/client_qlog" \
            -o "$RUN/downloads" \
            -t "$CERT" \
            127.0.0.1 "$PORT" /payload.bin \
            > "$RUN/client.log" 2>&1
        STATUS=$?
        ;;

    ngtcp2)
        timeout 90 "$EXP/ngtcp2/examples/gtlsclient" \
            --sni=localhost \
            --qlog-dir="$RUN/client_qlog" \
            --download="$RUN/downloads" \
            127.0.0.1 "$PORT" \
            "https://localhost:$PORT/payload.bin" \
            > "$RUN/client.log" 2>&1
        STATUS=$?
        ;;
esac
set -e

echo "Client process status: $STATUS"
echo "client_process_status=$STATUS" >> "$RUN/metadata.txt"

if [[ "$STATUS" -ne 0 ]]; then
    echo "FAIL: Client process failed. See $RUN/client.log" >&2
    exit 1
fi

if [[ "$STACK" == "picoquic" ]]; then
    if ! grep -q 'Client exit with code = 0' "$RUN/client.log"; then
        echo "FAIL: Picoquic reported application failure" >&2
        exit 1
    fi
    if grep -qiE 'based on stored ticket|zero RTT packets|after 0rtt' "$RUN/client.log"; then
        echo "FAIL: Picoquic attempted session resumption / 0-RTT" >&2
        exit 1
    fi
fi

DOWNLOADED="$RUN/downloads/payload.bin"

if ! cmp -s "$FIXTURE" "$DOWNLOADED"; then
    echo "FAIL: Payload mismatch or missing download" >&2
    exit 1
fi

sleep 1

CLIENT_QLOG_COUNT=$(find "$RUN/client_qlog" -type f \
    \( -name '*.qlog' -o -name '*.sqlog' \) -size +0c | wc -l)

SERVER_QLOG_COUNT=$(find "$RUN/server_qlog" -type f \
    \( -name '*.qlog' -o -name '*.sqlog' \) -size +0c | wc -l)

if [[ "$CLIENT_QLOG_COUNT" -ne 1 || "$SERVER_QLOG_COUNT" -ne 1 ]]; then
    echo "FAIL: Expected exactly one nonempty qlog per endpoint" >&2
    echo "Client qlogs: $CLIENT_QLOG_COUNT"
    echo "Server qlogs: $SERVER_QLOG_COUNT"
    exit 1
fi

echo "validation=PASS" >> "$RUN/metadata.txt"
echo "download_sha256=$(sha256sum "$DOWNLOADED" | cut -d' ' -f1)" \
    >> "$RUN/metadata.txt"

echo
echo "PASS: Identical 1 MiB HTTP/3 payload"
echo "SHA-256:"
sha256sum "$FIXTURE" "$DOWNLOADED"
echo
echo "Native qlogs:"
find "$RUN/client_qlog" "$RUN/server_qlog" \
    -type f -printf '%p (%s bytes)\n'
echo
echo "Output directory: $RUN"
